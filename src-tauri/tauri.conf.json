{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Timer",
  "version": "0.1.0",
  "identifier": "com.usoft.visualtimer",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node tools/copy-web.mjs",
    "beforeBuildCommand": "node tools/copy-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Visual Timer",
        "width": 360,
        "height": 400,
        "minWidth": 120,
        "minHeight": 120
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
